    {
      "id": "accepted-regions-applies-fx-to-out-of-region-card",
      "rule": "the inverse of the case above — a US card at an HK-only merchant IS cross-border. This is the PARKnSHOP case: it depends entirely on the merchant declaring businessRegion, and reads as a correct rate when the data is missing",
      "input": {
        "categoryID": "dining",
        "region": "HK",
        "acceptedRegions": [
          "HK"
        ]
      },
      "cards": [
        {
          "name": "FX Three",
