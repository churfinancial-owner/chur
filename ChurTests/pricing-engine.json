    {
      "id": "fx-fee-reorders-the-ranking",
      "rule": "computeEffectiveRate subtracts the FX fee on cross-border spend — the lower headline rate wins",
      "input": {
        "categoryID": "dining",
        "region": "TW"
      },
      "cards": [
        {
          "name": "FX Three",
          "country": "US",
          "hasForeignTransactionFee": true,
          "foreignTransactionFeeRate": 0.03,
          "rewards": [
            {
              "rate": 3.0,
              "categories": [
                "dining"
              ]
            }
          ]
        },
        {
          "name": "No FX Two",
          "country": "US",
          "rewards": [
            {
              "rate": 2.0,
              "categories": [
                "dining"
              ]
            }
          ]
        }
      ],
      "expected": [
        {
          "name": "No FX Two",
          "effectiveCashBackRate": 0.02
        },
        {
          "name": "FX Three",
          "effectiveCashBackRate": 0.0
        }
      ]
    },
    {
      "id": "force-cross-border-applies-fx-in-home-region",
      "rule": "forceCrossBorder overrides region comparison",
      "input": {
        "categoryID": "dining",
        "region": "US",
        "forceCrossBorder": true
      },
      "cards": [
        {
          "name": "FX Three",
          "country": "US",
          "hasForeignTransactionFee": true,
          "foreignTransactionFeeRate": 0.03,
          "rewards": [
            {
              "rate": 3.0,
              "categories": [
                "dining"
              ]
            }
          ]
        }
      ],
      "expected": [
        {
          "name": "FX Three",
          "effectiveCashBackRate": 0.0
        }
      ]
    },
    {
      "id": "accepted-regions-suppresses-fx",
      "rule": "acceptedRegions overrides the single region — a US card at a merchant operating in US+TW is not cross-border",
      "input": {
        "categoryID": "dining",
        "region": "TW",
        "acceptedRegions": [
          "US",
          "TW"
        ]
      },
      "cards": [
        {
          "name": "FX Three",
          "country": "US",
          "hasForeignTransactionFee": true,
          "foreignTransactionFeeRate": 0.03,
          "rewards": [
            {
              "rate": 3.0,
              "categories": [
                "dining"
              ]
