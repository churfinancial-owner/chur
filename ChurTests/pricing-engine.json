{
  "formatVersion": 1,
  "description": "Shared pricing-engine test vectors. Every case is (cards, category, inputs) -> expected ranking. Consumed by ChurTests/PricingEngineVectorTests.swift and, when Android exists, by the Kotlin port of CardRateCalculator. See Chur/PRICING_VECTORS_REFERENCE.md.",
  "categories": [
    {
      "id": "everything",
      "name": "Everything",
      "level": "parent"
    },
    {
      "id": "travel",
      "name": "Travel",
      "level": "parent"
    },
    {
      "id": "travel_portal",
      "name": "Travel Portal",
      "level": "child",
      "parentCategoryID": "travel"
    },
    {
      "id": "flights",
      "name": "Flights",
      "level": "child",
      "parentCategoryID": "travel",
      "categoryLinks": [
        "travel_portal"
      ]
    },
    {
      "id": "airline_delta",
      "name": "Delta",
      "level": "target",
      "parentCategoryID": "flights"
    },
    {
      "id": "dining",
      "name": "Dining",
      "level": "parent"
    },
    {
      "id": "grocery",
      "name": "Grocery",
      "level": "parent"
    },
    {
      "id": "wholefood",
      "name": "Whole Foods",
      "level": "target",
      "parentCategoryID": "grocery",
      "categoryLinks": [
        "amazon"
      ]
    },
    {
      "id": "online_retail",
      "name": "Online Retail",
      "level": "parent"
    },
    {
      "id": "amazon",
      "name": "Amazon",
      "level": "target",
      "parentCategoryID": "online_retail",
      "excludeFromParent": true
    },
    {
      "id": "wholesale",
      "name": "Wholesale Club",
      "level": "parent"
    },
    {
      "id": "costco",
      "name": "Costco",
      "level": "target",
      "parentCategoryID": "wholesale",
      "cardFilter": {
        "networks": [
          "Visa"
        ],
        "mode": "include"
      }
    },
    {
      "id": "walmart",
      "name": "Walmart",
      "level": "target",
      "parentCategoryID": "grocery",
      "excludeFromParent": true,
      "excludedPaymentMethods": [
        "apple_pay",
        "mobile_pay"
      ]
    },
    {
      "id": "apple_pay",
      "name": "Apple Pay",
      "level": "target"
    },
    {
      "id": "mobile_pay",
      "name": "Mobile Pay",
      "level": "target"
    },
    {
      "id": "paypal_pay",
      "name": "PayPal",
      "level": "target",
      "channels": [
        "online"
      ]
    }
  ],
  "vectors": [
    {
      "id": "exact-match-outranks-everything",
      "rule": "matchWeight step 1 (exact) and step 6 (everything fallback)",
      "input": {
        "categoryID": "dining",
        "region": "US"
      },
      "cards": [
        {
          "name": "Dining Five",
          "rewards": [
            {
              "rate": 5.0,
              "categories": [
                "dining"
              ]
            }
          ]
        },
        {
          "name": "Flat Two",
          "rewards": [
            {
              "rate": 2.0,
              "categories": [
                "everything"
              ]
            }
          ]
        }
      ],
      "expected": [
        {
          "name": "Dining Five",
          "effectiveCashBackRate": 0.05
        },
        {
          "name": "Flat Two",
          "effectiveCashBackRate": 0.02
        }
      ]
    },
    {
      "id": "parent-chain-single-hop",
      "rule": "matchWeight step 5 — flights inherits travel",
      "input": {
        "categoryID": "flights",
        "region": "US"
      },
      "cards": [
        {
          "name": "Travel Three",
          "rewards": [
            {
              "rate": 3.0,
              "categories": [
                "travel"
              ]
            }
          ]
        }
      ],
      "expected": [
        {
          "name": "Travel Three",
          "effectiveCashBackRate": 0.03
        }
      ]
    },
    {
      "id": "parent-chain-multi-hop",
      "rule": "matchWeight step 5 — airline_delta -> flights -> travel, two hops",
      "input": {
        "categoryID": "airline_delta",
        "region": "US"
      },
      "cards": [
        {
          "name": "Travel Three",
          "rewards": [
            {
              "rate": 3.0,
              "categories": [
                "travel"
              ]
            }
          ]
        }
      ],
      "expected": [
        {
          "name": "Travel Three",
          "effectiveCashBackRate": 0.03
        }
      ]
    },
    {
      "id": "ancestor-category-links-are-reachable",
      "rule": "buildAncestorSets folds each ancestor's categoryLinks into the reachable set — flights links travel_portal, so airline_delta reaches it",
      "input": {
        "categoryID": "airline_delta",
        "region": "US"
      },
      "cards": [
        {
          "name": "Portal Five",
          "rewards": [
            {
              "rate": 5.0,
              "categories": [
                "travel_portal"
              ]
            }
          ]
        }
      ],
      "expected": [
        {
          "name": "Portal Five",
          "effectiveCashBackRate": 0.05
        }
      ]
    },
    {
      "id": "category-links-match-directly",
      "rule": "matchWeight step 2 — wholefood links amazon",
      "input": {
        "categoryID": "wholefood",
        "region": "US"
      },
      "cards": [
        {
          "name": "Amazon Five",
          "rewards": [
            {
              "rate": 5.0,
              "categories": [
                "amazon"
              ]
            }
          ]
        },
        {
          "name": "Flat One",
          "rewards": [
            {
              "rate": 1.0,
              "categories": [
                "everything"
              ]
            }
          ]
        }
      ],
      "expected": [
        {
          "name": "Amazon Five",
          "effectiveCashBackRate": 0.05
        },
        {
          "name": "Flat One",
          "effectiveCashBackRate": 0.01
        }
      ]
    },
